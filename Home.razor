@page "/"
@rendermode InteractiveServer

@inject IJSRuntime Js

@using Vision.Components.Home

<PageTitle>Home</PageTitle>

<div class="h-screen overflow-hidden bg-gray-300 flex flex-col">

    <Header />

    <main class="flex flex-col flex-1 min-h-0 px-2 pb-2">

        <div class="flex flex-col flex-1 min-h-0">

            <DashboardCard />

            <BIMViewport AccessToken="@_accessToken" ProjectId="@_projectId" />

        </div>

    </main>

</div>

@code {

    private IJSObjectReference? _module;
    private DotNetObjectReference<Home>? _dotNetRef;

    private string? _accessToken;
    private string? _projectId;


    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!firstRender)
            return;

        _dotNetRef = DotNetObjectReference.Create(this);

        _module = await Js.InvokeAsync<IJSObjectReference>(
            "import",
            "/js/trimbleWorkspace.js");

        var result = await _module.InvokeAsync<TrimbleInitResult>(
            "initialize",
            _dotNetRef);

        if (result.IsRunningInTrimble)
        {
            Console.WriteLine(
                $"Connected to Trimble project: {result.Project?.Name}");

            _projectId = result.Project?.Id;

            // Ask Trimble for the access token.
            var tokenResult = await _module.InvokeAsync<string?>(
                "requestAccessToken");

            if (!string.IsNullOrWhiteSpace(tokenResult))
            {
                _accessToken = tokenResult;

                StateHasChanged();
            }
        }
    }


    [JSInvokable]
    public void OnTrimbleAccessToken(string token)
    {
        Console.WriteLine("Trimble access token received.");

        _accessToken = token;

        StateHasChanged();
    }


    [JSInvokable]
    public void OnTrimbleCommand(string command)
    {
        Console.WriteLine(
            $"Trimble command received: {command}");
    }


    public async ValueTask DisposeAsync()
    {
        if (_module is not null)
        {
            try
            {
                await _module.InvokeVoidAsync("dispose");
                await _module.DisposeAsync();
            }
            catch
            {
                // Trimble connection may already be disconnected.
            }
        }

        _dotNetRef?.Dispose();
    }


    public class TrimbleInitResult
    {
        public bool IsRunningInTrimble { get; set; }

        public Project? Project { get; set; }
    }


    public class Project
    {
        public string Id { get; set; } = "";

        public string Name { get; set; } = "";
    }
}