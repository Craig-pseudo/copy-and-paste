@using Vision.Components.Home.RightAsideTabs


@inject IJSRuntime JS

<aside class="w-2/8 bg-white rounded-xl p-0 flex flex-col h-full overflow-hidden">

    <!--This is the top selector at the top-->
    <div class="bg-white rounded-sm">
        <div class="grid grid-rows-3 p-3">
            <h2>COL-CNV-012</h2>
            <a>UC 152 x 152 x 37 Column</a>
            <a>Area 3 - CV-300 Corridor</a>
        </div>

        <div class="flex gap-2 py-1 px-2">
            <div class="w-1/3 h-12 rounded-sm bg-green-200 border border-green-600 text-green-700 flex items-center justify-center">C4 - Good</div>
            <div class="w-1/3 h-12 rounded-sm bg-green-200 border border-green-600 text-green-700 flex items-center justify-center">P4 - Low</div>
            <div class="w-1/3 h-12 rounded-sm bg-green-200 border border-green-600 text-green-700 flex items-center justify-center">Sensor Warning</div>
        </div>

        <div class="px-2 pb-2">
            <div class="grid grid-cols-2 gap-2 mt-2">

                <div class="w-full h-14 px-2 pb-2 rounded-sm border border-gray-300">
                    <h2 class="text-gray-400">Profile</h2>
                    <a class="text-gray-800 font-medium">152 x 152 x 37 UC</a>
                </div>

                <div class="w-full h-14 px-2 pb-2 rounded-sm border border-gray-300">
                    <h2 class="text-gray-400">Mass</h2>
                    <a class="text-gray-800 font-medium">638 Kg</a>
                </div>

                <div class="w-full h-14 px-2 pb-2 rounded-sm border border-gray-300">
                    <h2 class="text-gray-400">Paint Area</h2>
                    <a class="text-gray-800 font-medium">14.6 m²</a>
                </div>

                <div class="w-full h-14 px-2 pb-2 rounded-sm border border-gray-300">
                    <h2 class="text-gray-400">Length</h2>
                    <a class="text-gray-800 font-medium">9.4 m</a>
                </div>

            </div>
        </div>
    </div>

    <!--This is the inspoection history-->

    <div class="rounded-sm flex flex-col flex-1 min-h-0 border-t border-gray-300">

        <!--This is condition and telemtry and work orders-->
        <div class="flex w-full border-b border-gray-300">
            <button class="flex-1 py-2 @(activeTab == Tab.Condition ? "text-blue-600 font-semibold" : "")"
                    @onclick="() => activeTab = Tab.Condition">
                <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" data-lucide="activity" aria-hidden="true" class="lucide lucide-activity w-[11px] h-[11px] inline-flex"><path d="M22 12h-2.48a2 2 0 0 0-1.93 1.46l-2.35 8.36a.25.25 0 0 1-.48 0L9.24 2.18a.25.25 0 0 0-.48 0l-2.35 8.36A2 2 0 0 1 4.49 12H2"></path></svg>
                Condition
            </button>
            <button class="flex-1 py-2 @(activeTab == Tab.Telemetry ? "text-blue-600 font-semibold" : "")"
                    @onclick="() => activeTab = Tab.Telemetry">
                <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" data-lucide="radio" aria-hidden="true" class="lucide lucide-radio w-[11px] h-[11px] inline-flex"><path d="M16.247 7.761a6 6 0 0 1 0 8.478"></path><path d="M19.075 4.933a10 10 0 0 1 0 14.134"></path><path d="M4.925 19.067a10 10 0 0 1 0-14.134"></path><path d="M7.753 16.239a6 6 0 0 1 0-8.478"></path><circle cx="12" cy="12" r="2"></circle></svg>
                Telemetry
            </button>
            <button class="flex-1 py-2 @(activeTab == Tab.WorkOrders ? "text-blue-600 font-semibold" : "")"
                    @onclick="() => activeTab = Tab.WorkOrders">
                <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" data-lucide="file-text" aria-hidden="true" class="lucide lucide-file-text w-[11px] h-[11px] inline-flex"><path d="M6 22a2 2 0 0 1-2-2V4a2 2 0 0 1 2-2h8a2.4 2.4 0 0 1 1.704.706l3.588 3.588A2.4 2.4 0 0 1 20 8v12a2 2 0 0 1-2 2z"></path><path d="M14 2v5a1 1 0 0 0 1 1h5"></path><path d="M10 9H8"></path><path d="M16 13H8"></path><path d="M16 17H8"></path></svg>
                Work Orders
            </button>
        </div>


        <div class="flex-1 min-h-0 overflow-hidden p-2">

            @if (activeTab == Tab.Condition)
            {
                <!--Consition - Inspection History-->

                <div class="h-full overflow-y-auto">

                    <Condition />

                </div>
            }
            else if (activeTab == Tab.Telemetry)
            {
                <!--Telemetry - displacement and vibration and the live displacement and the vibration RMS-->

                <div class="h-full overflow-y-auto">

                    <Telemetry/>
                    
                </div>
            }
            else if (activeTab == Tab.WorkOrders)
            {
                <!--Work Orders -->

                <div class="h-full flex flex-col gap-3">

                   <WorkOrders />

                </div>
            }

        </div>
    </div>
</aside>


@code {
    private enum Tab { Condition, Telemetry, WorkOrders }
    private Tab activeTab = Tab.Condition;

    
}