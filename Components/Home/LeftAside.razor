@inject IJSRuntime JS

  <aside class="w-1/8 bg-white rounded-xl  space-y-0 overflow-y-auto">
                    <div class="w-full ">


                        <!-- Filter Header -->
<div class="flex items-center justify-between h-6 px-2 ">

    <!-- Left: Filter icon + title -->
    <div class="flex items-center gap-2">

        <!-- Filter Icon -->
        <svg class="w-4 h-4 text-blue-500"
             aria-hidden="true"
             xmlns="http://www.w3.org/2000/svg"
             fill="none"
             viewBox="0 0 24 24">

            <path stroke="currentColor"
                  stroke-linecap="round"
                  stroke-linejoin="round"
                  stroke-width="2"
                  d="M4 6h16M6 12h12m-9 6h6" />

        </svg>

        <span class="text-sm font-medium text-gray-600">
            Filters
        </span>

    </div>


    <!-- Right: Clear button -->
    <button type="button"
            class="text-xs text-gray-500 hover:text-blue-600 transition">
        Clear
    </button>

</div>


    <!-- Accordion 1 - Area -->
    <details class="group bg-white border border-gray-200">

    <summary class="flex items-center justify-between cursor-pointer px-3 py-3 text-sm text-gray-500 list-none h-7">

        <span>Area</span>

        <!-- Arrow -->
        <span class="text-gray-500 accordion-arrow">
            >
        </span>

    </summary>


    <div class="px-4 pb-2 space-y-1">

        <!-- Area 1 -->
        <label class="flex items-center gap-3 text-sm text-gray-500 cursor-pointer">

            <input type="checkbox"
                   class="filter-checkbox" />

            <span>Area 1</span>

        </label>


        <!-- Area 2 -->
        <label class="flex items-center gap-3 text-sm text-gray-500 cursor-pointer">

            <input type="checkbox"
                   class="filter-checkbox" />

            <span>Area 2</span>

        </label>


        <!-- Area 3 -->
        <label class="flex items-center gap-3 text-sm text-gray-500 cursor-pointer">

            <input type="checkbox"
                   class="filter-checkbox"/>

            <span>Area 3</span>

        </label>


        <!-- Area 4 -->
        <label class="flex items-center gap-3 text-sm text-gray-500 cursor-pointer">

            <input type="checkbox"
                   class="filter-checkbox" />

            <span>Area 4</span>

        </label>

    </div>

</details>



    <!-- Accordion 2 - Structure Type -->
<details class="group bg-white border border-gray-200">

    <summary class="flex items-center justify-between cursor-pointer px-3 py-3 text-sm text-gray-500 list-none h-7">

        <span>Structure Type</span>

        <span class="text-gray-500 accordion-arrow">
            >
        </span>

    </summary>

    <div class="px-4 pb-2 space-y-1">

        <label class="flex items-center gap-3 text-sm text-gray-500 cursor-pointer">
            <input type="checkbox"
                   class="filter-checkbox" />
            <span>Conveyor</span>
        </label>

        <label class="flex items-center gap-3 text-sm text-gray-500 cursor-pointer">
            <input type="checkbox"
                   class="filter-checkbox"/>
            <span>Pipe Rack</span>
        </label>

        <label class="flex items-center gap-3 text-sm text-gray-500 cursor-pointer">
            <input type="checkbox"
                   class="filter-checkbox" />
            <span>Silo</span>
        </label>

        <label class="flex items-center gap-3 text-sm text-gray-500 cursor-pointer">
            <input type="checkbox"
                   class="filter-checkbox" />
            <span>Access Platform</span>
        </label>

        <label class="flex items-center gap-3 text-sm text-gray-500 cursor-pointer">
            <input type="checkbox"
                   class="filter-checkbox" />
            <span>Stockpile Frame</span>
        </label>

    </div>

</details>


<!-- Accordion 3 - Structural Category -->
<details class="group bg-white border border-gray-200">

    <summary class="flex items-center justify-between cursor-pointer px-3 py-3 text-sm text-gray-500 list-none h-7">

        <span>Structural Category</span>

        <span class="text-gray-500 accordion-arrow">
            >
        </span>

    </summary>

    <div class="px-4 pb-2 space-y-1">

        <label class="flex items-center gap-3 text-sm text-gray-500 cursor-pointer">
            <input type="checkbox"
                   class="filter-checkbox"/>
            <span>Beam</span>
        </label>

        <label class="flex items-center gap-3 text-sm text-gray-500 cursor-pointer">
            <input type="checkbox"
                   class="filter-checkbox" />
            <span>Column</span>
        </label>

        <label class="flex items-center gap-3 text-sm text-gray-500 cursor-pointer">
            <input type="checkbox"
                   class="filter-checkbox" />
            <span>Bracing</span>
        </label>

        <label class="flex items-center gap-3 text-sm text-gray-500 cursor-pointer">
            <input type="checkbox"
                   class="filter-checkbox" />
            <span>Connection</span>
        </label>

        <label class="flex items-center gap-3 text-sm text-gray-500 cursor-pointer">
            <input type="checkbox"
                   class="filter-checkbox" />
            <span>Grafting</span>
        </label>

    </div>

</details>


<!-- Accordion 4 - Condition Rating -->
<details class="group bg-white border border-gray-200">

    <summary class="flex items-center justify-between cursor-pointer px-3 py-3 text-sm text-gray-500 list-none h-7">

        <span>Condition Rating</span>

        <span class="text-gray-500 accordion-arrow">
            >
        </span>

    </summary>

    <div class="px-4 pb-2 space-y-1">

        <label class="flex items-center gap-3 text-sm text-gray-500 cursor-pointer">
            <input type="checkbox"
                   class="filter-checkbox urgent " />
            <span>1 - Critical</span>
                    <span class="w-2 h-2 mb-0.5 rounded-full bg-red-600
                        peer-checked:bg-red-600 transition-colors">
                    </span>
        </label>

        <label class="flex items-center gap-3 text-sm text-gray-500 cursor-pointer">
            <input type="checkbox"
                   class="filter-checkbox high" />
            <span>2 - Poor</span>
                    <span class="w-2 h-2 mb-0.5 rounded-full bg-red-400
                        peer-checked:bg-red-400 transition-colors">
                    </span>
        </label>

        <label class="flex items-center gap-3 text-sm text-gray-500 cursor-pointer">
            <input type="checkbox"
                   class="filter-checkbox medium" />
            <span>3 - Moderate</span>
                    <span class="w-2 h-2 mb-0.5 rounded-full bg-orange-500
                        peer-checked:bg-orange-500 transition-colors">
                    </span>
        </label>

        <label class="flex items-center gap-3 text-sm text-gray-500 cursor-pointer">
            <input type="checkbox"
                   class="filter-checkbox low" />
            <span>4 - Good</span>
                    <span class="w-2 h-2 mb-0.5 rounded-full bg-green-400
                        peer-checked:bg-green-400 transition-colors">
                    </span>
        </label>

        <label class="flex items-center gap-3 text-sm text-gray-500 cursor-pointer">
            <input type="checkbox"
                   class="filter-checkbox nonUrgent" />
            <span>5 - Acceptable</span>
                    <span class="w-2 h-2 mb-0.5 rounded-full bg-green-600
                        peer-checked:bg-green-600 transition-colors">
                    </span>
        </label>

    </div>

</details>


<!-- Accordion 5 - Priority Level -->
<details class="group bg-white border border-gray-200">

    <summary class="flex items-center justify-between cursor-pointer px-3 py-3 text-sm text-gray-500 list-none h-7">

        <span>Priority Level</span>

        <span class="text-gray-500 accordion-arrow">
            >
        </span>

    </summary>

    <div class="px-4 pb-2 space-y-1">

        <label class="flex items-center gap-3 text-sm text-gray-500 cursor-pointer">
            <input type="checkbox"
                   class="filter-checkbox urgent" />
            <span>P1 - Urgent</span>
                    <span class="w-2 h-2 mb-0.5 rounded-full bg-red-600
                        peer-checked:bg-red-600 transition-colors">
                    </span>
        </label>

        <label class="flex items-center gap-3 text-sm text-gray-500 cursor-pointer">
            <input type="checkbox"
                   class="filter-checkbox high" />
            <span>P2 - High</span>
                    <span class="w-2 h-2 mb-0.5 rounded-full bg-red-400
                        peer-checked:bg-red-400 transition-colors">
                    </span>
        </label>

        <label class="flex items-center gap-3 text-sm text-gray-500 cursor-pointer">
            <input type="checkbox"
                   class="filter-checkbox medium" />
            <span>P3 - Medium</span>
                    <span class="w-2 h-2 mb-0.5 rounded-full bg-orange-500
                        peer-checked:bg-orange-500 transition-colors">
                    </span>
        </label>

        <label class="flex items-center gap-3 text-sm text-gray-500 cursor-pointer">
            <input type="checkbox"
                   class="filter-checkbox low" />
            <span>P4 - Low</span>
                    <span class="w-2 h-2 mb-0.5 rounded-full bg-green-400
                        peer-checked:bg-green-400 transition-colors">
                    </span>
        </label>

        <label class="flex items-center gap-3 text-sm text-gray-500 cursor-pointer">
            <input type="checkbox"
                   class="filter-checkbox nonUrgent" />
            <span>P5 - Non-Urgent</span>
                    <span class="w-2 h-2 mb-0.5 rounded-full bg-green-600
                        peer-checked:bg-green-600 transition-colors">
                    </span>
        </label>

    </div>

</details>


<!-- Accordion 6 - Sensor Status -->
<details class="group bg-white border border-gray-200">

    <summary class="flex items-center justify-between cursor-pointer px-3 py-3 text-sm text-gray-500 list-none h-7">

        <span>Sensor Status</span>

        <span class="text-gray-500 accordion-arrow">
            >
        </span>

    </summary>

            <div class="px-4 pb-2 space-y-1">

                <label class="flex items-center gap-3 text-sm text-gray-500 cursor-pointer">
                    <input type="checkbox" class="filter-checkbox normal" />
                    <span>Normal</span>
                    <span class="w-2 h-2 mb-0.5 rounded-full bg-green-500"></span>
                </label>

                <label class="flex items-center gap-3 text-sm text-gray-500 cursor-pointer">
                    <input type="checkbox" class="filter-checkbox warning" />
                    <span>Warning</span>
                    <span class="w-2 h-2 mb-0.5 rounded-full bg-orange-500"></span>
                </label>

                <label class="flex items-center gap-3 text-sm text-gray-500 cursor-pointer">
                    <input type="checkbox" class="filter-checkbox alarm" />
                    <span>Alarm</span>
                    <span class="w-2 h-2 mb-0.5 rounded-full bg-red-500"></span>
                </label>

            </div>

</details>

</div>

<!--This the bottom part that will change alot -->

    <div>
        <!--Memebrs part where its determined by how many memebers are selected-->

           <div class="px-3 h-7 ">
               <a class="text-gray-500 text-sm">12 Members</a>
           </div>

           <!--This is the members part where they are displayed-->

          <!-- Example 1 -->
<div @onclick="() => ToggleSelected(1)"
     class="w-full cursor-pointer pb-1 border-l-4
            @(selectedItem == 1 ? "bg-gray-200" : "bg-white")"
     style="border-left-color: @(selectedItem == 1 ? "#22c55e" : "transparent");">

    <div class="grid grid-rows-2 px-3 w-2/3">

        <div class="text-sm text-gray-500">
            BEAM-CNV-042
        </div>

        <div class="grid grid-cols-4 text-sm gap-2">

            <div class="bg-red-100 border border-red-800 flex items-center justify-center">
                C1
            </div>

            <div class="col-span-2 text-sm bg-transparent">
                Conveyor
            </div>

        </div>

    </div>

</div>


<!-- Example 2 -->
<div @onclick="() => ToggleSelected(2)"
     class="w-full cursor-pointer pb-1 border-l-4
            @(selectedItem == 2 ? "bg-gray-200" : "bg-white")"
     style="border-left-color: @(selectedItem == 2 ? "#22c55e" : "transparent");">

    <div class="grid grid-rows-4 px-3 w-2/3">

        <div class="text-sm text-gray-500">
            COL-PR-017
        </div>

        <div class="grid grid-cols-4 text-sm gap-2">

            <div class="bg-orange-100 border border-orange-800 flex items-center justify-center">
                C2
            </div>

            <div class="col-span-2 text-sm bg-transparent">
                Pipe Rack
            </div>

        </div>

    </div>

</div>


<!-- Example 3 -->
<div @onclick="() => ToggleSelected(3)"
     class="w-full cursor-pointer pb-1 border-l-4
            @(selectedItem == 3 ? "bg-gray-200" : "bg-white")"
     style="border-left-color: @(selectedItem == 3 ? "#22c55e" : "transparent");">

    <div class="grid grid-rows-2 px-3 w-2/3">

        <div class="text-sm text-gray-500">
            COL-CNV-012
        </div>

        <div class="grid grid-cols-4 text-sm gap-2">

            <div class="bg-green-100 border border-green-800 flex items-center justify-center">
                C4
            </div>

                    <div class="col-span-2 text-sm bg-transparent">
                Conveyor
            </div>

        </div>

    </div>

</div>

</div>


                </aside>

@code {

    private int? selectedItem = null;

    private void ToggleSelected(int itemId)
    {
        if (selectedItem == itemId)
        {
            selectedItem = null;
        }
        else
        {
            selectedItem = itemId;
        }
    }

}

