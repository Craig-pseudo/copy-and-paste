@using Vision.Components.Home.RightAsideTabs
@inject IJSRuntime JS

<div class="flex flex-col gap-3">
    <div class="bg-white rounded-sm p-3">
        <h3 class="text-xs font-semibold text-gray-400 tracking-wide mb-2">INSPECTION HISTORY</h3>

        <!-- Latest note -->
        <div class="border-l-4 border-orange-400 bg-gray-50 rounded-r-sm p-2 mb-4">
            <p class="text-xs text-gray-500 mb-1">Latest note — @latestNote.Author · @latestNote.Date.ToString("yyyy-MM-dd")</p>
            <p class="text-sm text-gray-800 font-medium">@latestNote.Text</p>
        </div>

        <!-- Timeline -->
        <div class="relative">
            <!-- Connector line running behind the circles -->
            <div class="absolute left-[13px] top-3 bottom-3 w-0.5 bg-gray-200 z-0"></div>

            <div class="space-y-4">
                @foreach (var entry in inspectionHistory)
                {
                    <div class="relative z-10 flex gap-3">
                        <div class="flex-shrink-0 w-7 h-7 rounded-full flex items-center justify-center text-white text-xs font-semibold @GetSeverityBg(entry.Severity)">
                            @entry.Number
                        </div>
                        <div class="flex-1">
                            <div class="flex items-center justify-between">
                                <span class="text-sm font-bold uppercase @GetSeverityText(entry.Severity)">@entry.Severity</span>
                                <span class="text-xs text-gray-400">@entry.Date.ToString("yyyy-MM-dd")</span>
                            </div>
                            <p class="text-sm text-gray-700 mt-0.5">@entry.Description</p>
                            <p class="text-xs text-gray-400 mt-0.5">↳ @entry.Author</p>
                        </div>
                    </div>
                }
            </div>
        </div>

        <!-- Site Photos -->
        <div class="mt-4">
            <h3 class="text-xs font-semibold text-gray-400 tracking-wide mb-2">SITE PHOTOS</h3>
            <div class="grid grid-cols-3 gap-2">
                @foreach (var photo in sitePhotos)
                {
                    <div class="flex flex-col items-center gap-1 cursor-pointer" @onclick="() => OnPhotoClick(photo)">
                        <div class="w-full aspect-square bg-gray-100 border border-gray-200 rounded-sm flex items-center justify-center hover:bg-gray-200">
                            <svg xmlns="http://www.w3.org/2000/svg" class="w-5 h-5 text-gray-400" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.5">
                                <circle cx="12" cy="12" r="9" />
                                <line x1="12" y1="10" x2="12" y2="16" />
                                <circle cx="12" cy="7.5" r="0.75" fill="currentColor" stroke="none" />
                            </svg>
                        </div>
                        <span class="text-xs text-gray-500">@photo.Caption</span>
                    </div>
                }
            </div>
        </div>
    </div>
</div>

@code {
    private enum Tab { Condition, Telemetry, WorkOrders }
    private Tab activeTab = Tab.Condition;

    // CONDITION TAB — inspection history data + helpers


    private record InspectionEntry(int Number, string Severity, DateTime Date, string Description, string Author);
    private record Note(string Author, DateTime Date, string Text);
    private record Photo(string Caption, string? Url);

    private Note latestNote = new("S. Nguyen", new DateTime(2026, 5, 20),
        "Surface oxidation with minor section loss. Monitoring quarterly.");

    private List<InspectionEntry> inspectionHistory = new()
    {
        new(1, "Critical",   new DateTime(2026, 7, 14), "Section loss >30% mid-span. Immediate action.", "D. Vickers"),
        new(2, "Poor",       new DateTime(2026, 1, 8),  "Progressing corrosion. Remediation scope raised.", "T. Marshall"),
        new(3, "Moderate",   new DateTime(2025, 6, 22), "Moderate surface corrosion. Monitor quarterly.", "S. Nguyen"),
        new(4, "Good",       new DateTime(2025, 1, 15), "Light rust. Paint system partially intact.", "D. Vickers"),
        new(5, "Acceptable", new DateTime(2024, 7, 3),  "Good condition. Full paint coverage.", "R. Kamau"),
    };

    private List<Photo> sitePhotos = new()
    {
        new("Flange corrosion", null),
        new("Web section loss", null),
        new("Connection detail", null),
    };

    private string GetSeverityBg(string severity) => severity switch
    {
        "Critical" => "bg-red-500",
        "Poor" => "bg-orange-500",
        "Moderate" => "bg-amber-500",
        "Good" => "bg-green-600",
        "Acceptable" => "bg-emerald-500",
        _ => "bg-gray-400"
    };

    private string GetSeverityText(string severity) => severity switch
    {
        "Critical" => "text-red-600",
        "Poor" => "text-orange-500",
        "Moderate" => "text-amber-600",
        "Good" => "text-green-600",
        "Acceptable" => "text-emerald-600",
        _ => "text-gray-500"
    };

    private void OnPhotoClick(Photo photo)
    {
        // TODO: wire up to a lightbox/viewer once photo.Url is populated
    }
}
