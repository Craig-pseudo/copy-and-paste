<div class="rounded-xl border border-gray-200 bg-white p-4 shadow-sm">

    <h3 class="text-[10px] font-medium text-gray-500 tracking-wide">
        MOVEMENT SENSORS
    </h3>

    <div class="flex items-start justify-between mt-2">

        <div>
            <span class="text-3xl font-bold text-blue-600">@totalActiveSensors</span>
            <p class="text-[10px] text-gray-500 leading-tight mt-1">total active</p>
        </div>

        <!-- legend: colored dot + label + count, one row per status -->
        <div class="flex flex-col gap-1 mt-1">
            @foreach (var status in sensorStatusBreakdown)
            {
                <div class="flex items-center gap-1.5 text-[11px] text-gray-600">
                    <span class="w-2 h-2 rounded-full flex-shrink-0 @status.DotColorClass"></span>
                    <span>@status.Label</span>
                    <span class="font-semibold text-gray-800">@status.Count</span>
                </div>
            }
        </div>

    </div>

    <!-- alert pill, only shown if there are active alerts -->
    @if (activeSensorAlerts > 0)
    {
        <div class="mt-2 text-[11px] font-medium px-2 py-1 rounded-sm bg-red-50 text-red-500 inline-flex items-center gap-1">
            <!-- warning triangle icon -->
            <svg class="w-3 h-3" xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                <path stroke-linecap="round" stroke-linejoin="round" d="M12 9v4m0 4h.01M10.3 3.8 2.9 18a2 2 0 0 0 1.8 3h14.6a2 2 0 0 0 1.8-3L13.7 3.8a2 2 0 0 0-3.4 0Z" />
            </svg>
            @activeSensorAlerts sensor alerts active
        </div>
    }

</div>

@code {
    // CARD 4 — MOVEMENT SENSORS

    private int totalActiveSensors = 12;
    private int activeSensorAlerts = 4;

    private record SensorStatusCount(string Label, int Count, string DotColorClass);

    // -- legend rows, in display order (Alarm / Warning / Normal) --
    private List<SensorStatusCount> sensorStatusBreakdown = new()
    {
        new("Alarm",   2, "bg-red-400"),
        new("Warning", 2, "bg-orange-400"),
        new("Normal",  8, "bg-green-500"),
    };
}
