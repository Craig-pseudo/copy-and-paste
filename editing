protected override async Task OnAfterRenderAsync(bool firstRender)
{
    if (!firstRender)
        return;

    try
    {
        _trimbleModule = await JS.InvokeAsync<IJSObjectReference>(
            "import",
            "/js/trimbleDashboard.js");
    }
    catch (Exception ex)
    {
        Console.WriteLine($"Failed to load trimbleDashboard.js: {ex.Message}");
        return; // _trimbleModule stays null; InitializeTrimbleViewerAsync will just no-op
    }

    await InitializeTrimbleViewerAsync();
}

protected override async Task OnParametersSetAsync()
{
    await InitializeTrimbleViewerAsync();
}
