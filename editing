@using Vision.Components.Home.RightAsideTabs
@inject IJSRuntime JS

<div class="flex flex-col gap-3">

    @if (SelectedMember is null)
    {
        <div class="bg-white rounded-sm p-3">
            <p class="text-sm text-gray-500">
                Select a member to view its condition.
            </p>
        </div>
    }
    else
    {
        <div class="bg-white rounded-sm p-3">

            <!-- Selected Member -->
            <div class="mb-4">
                <h3 class="text-xs font-semibold text-gray-400 tracking-wide mb-1">
                    SELECTED MEMBER
                </h3>

                <p class="text-sm font-semibold text-gray-800">
                    @SelectedMember.Name
                </p>

                <p class="text-xs text-gray-400">
                    @SelectedMember.IfcGuid
                </p>
            </div>


            <!-- ================================================= -->
            <!-- INSPECTION HISTORY -->
            <!-- ================================================= -->

            <h3 class="text-xs font-semibold text-gray-400 tracking-wide mb-2">
                INSPECTION HISTORY
            </h3>


            <!-- Latest note -->

            <div class="border-l-4 border-orange-400 bg-gray-50 rounded-r-sm p-2 mb-4">

                <p class="text-xs text-gray-500 mb-1">
                    Latest note —
                    @CurrentLatestNote.Author
                    ·
                    @CurrentLatestNote.Date.ToString("yyyy-MM-dd")
                </p>

                <p class="text-sm text-gray-800 font-medium">
                    @CurrentLatestNote.Text
                </p>

            </div>


            <!-- Timeline -->

            <div class="relative">

                <!-- Connector line -->

                <div class="absolute left-[13px] top-3 bottom-3 w-0.5 bg-gray-200 z-0">
                </div>


                <div class="space-y-4">

                    @foreach (var entry in CurrentInspectionHistory)
                    {
                        <div class="relative z-10 flex gap-3">

                            <div class="
                                flex-shrink-0
                                w-7
                                h-7
                                rounded-full
                                flex
                                items-center
                                justify-center
                                text-white
                                text-xs
                                font-semibold
                                @GetSeverityBg(entry.Severity)">

                                @entry.Number

                            </div>


                            <div class="flex-1">

                                <div class="flex items-center justify-between">

                                    <span class="
                                        text-sm
                                        font-bold
                                        uppercase
                                        @GetSeverityText(entry.Severity)">

                                        @entry.Severity

                                    </span>

                                    <span class="text-xs text-gray-400">

                                        @entry.Date.ToString("yyyy-MM-dd")

                                    </span>

                                </div>


                                <p class="text-sm text-gray-700 mt-0.5">

                                    @entry.Description

                                </p>


                                <p class="text-xs text-gray-400 mt-0.5">

                                    ↳ @entry.Author

                                </p>

                            </div>

                        </div>
                    }

                </div>

            </div>


            <!-- ================================================= -->
            <!-- SITE PHOTOS -->
            <!-- ================================================= -->

            <div class="mt-4">

                <h3 class="text-xs font-semibold text-gray-400 tracking-wide mb-2">
                    SITE PHOTOS
                </h3>


                <div class="grid grid-cols-3 gap-2">

                    @foreach (var photo in CurrentSitePhotos)
                    {
                        <div
                            class="flex flex-col items-center gap-1 cursor-pointer"
                            @onclick="() => OnPhotoClick(photo)">

                            <div class="
                                w-full
                                aspect-square
                                bg-gray-100
                                border
                                border-gray-200
                                rounded-sm
                                overflow-hidden
                                flex
                                items-center
                                justify-center
                                hover:bg-gray-200">

                                @if (photo.Url is not null)
                                {
                                    <img
                                        src="@photo.Url"
                                        alt="@photo.Caption"
                                        class="w-full h-full object-cover" />
                                }
                                else
                                {
                                    <svg
                                        xmlns="http://www.w3.org/2000/svg"
                                        class="w-5 h-5 text-gray-400"
                                        fill="none"
                                        viewBox="0 0 24 24"
                                        stroke="currentColor"
                                        stroke-width="1.5">

                                        <circle cx="12" cy="12" r="9" />

                                        <line
                                            x1="12"
                                            y1="10"
                                            x2="12"
                                            y2="16" />

                                        <circle
                                            cx="12"
                                            cy="7.5"
                                            r="0.75"
                                            fill="currentColor"
                                            stroke="none" />

                                    </svg>
                                }

                            </div>


                            <span class="text-xs text-gray-500">
                                @photo.Caption
                            </span>

                        </div>
                    }

                </div>

            </div>

        </div>
    }

</div>


