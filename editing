@code {

    [Parameter]
    public string? AccessToken { get; set; }

    [Parameter]
    public string? ProjectId { get; set; }

    private ElementReference _iframeRef;

    private IJSObjectReference? _trimbleModule;

    private bool _viewerInitialized;
    private bool _viewerInitializing;




    // DROPDOWN STATE


    private bool groupDropdownOpen = false;
    private bool valueDropdownOpen = false;



    // CURRENT SELECTIONS


    private string selectedGroup = "None";
    private string selectedValue = "Select...";



    // FIRST DROPDOWN OPTIONS


    private List<string> groupOptions = new()
    {
        "None",
        "Condition",
        "Priority",
        "Structure Type",
        "Category",
        "Area",
        "Profile"
    };


    // SECOND DROPDOWN OPTIONS


    private Dictionary<string, List<string>> groupValues = new()
    {
        ["Condition"] = new()
        {
            "None",
            "Priority",
            "Structure Type",
            "Category",
            "Area",
            "Profile"
        },

        ["Priority"] = new()
        {
            "None",
        "Condition",
        "Structure Type",
        "Category",
        "Area",
        "Profile"
        },

        ["Structure Type"] = new()
        {
            "None",
        "Condition",
        "Priority",
        "Category",
        "Area",
        "Profile"
        },

        ["Category"] = new()
        {
            "None",
        "Condition",
        "Priority",
        "Structure Type",
        "Area",
        "Profile"
        },

        ["Area"] = new()
        {
            "None",
        "Condition",
        "Priority",
        "Structure Type",
        "Category",
        "Profile"
        },

        ["Profile"] = new()
        {
            "None",
        "Condition",
        "Priority",
        "Structure Type",
        "Category",
        "Area"
        }
    };


    // GET OPTIONS FOR SECOND DROPDOWN


    private IEnumerable<string> CurrentValues
    {
        get
        {
            if (groupValues.TryGetValue(selectedGroup, out var values))
            {
                return values;
            }

            return Enumerable.Empty<string>();
        }
    }


    // FIRST DROPDOWN


    private void ToggleGroupDropdown()
    {
        groupDropdownOpen = !groupDropdownOpen;

        // Close second dropdown
        valueDropdownOpen = false;
    }


    private void SelectGroup(string group)
    {
        selectedGroup = group;

        // Close first dropdown
        groupDropdownOpen = false;

        // Reset second selection
        selectedValue = "Select...";

        // Close second dropdown
        valueDropdownOpen = false;
    }


    // SECOND DROPDOWN

    private void ToggleValueDropdown()
    {
        valueDropdownOpen = !valueDropdownOpen;
    }


    private void SelectValue(string value)
    {
        selectedValue = value;

        valueDropdownOpen = false;
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!firstRender)
            return;

        try
        {
            _trimbleModule = await JS.InvokeAsync<IJSObjectReference>(
                "import",
                "/js/trimbleDashboard.js");
        }
        catch (Exception ex)
        {
            // Guard against an unhandled exception here killing the whole
            // Blazor circuit - this must fail soft, not take the app down.
            Console.WriteLine($"Failed to load trimbleDashboard.js: {ex.Message}");
            return;
        }

        await InitializeTrimbleViewerAsync();
    }

    protected override async Task OnParametersSetAsync()
    {
        // AccessToken/ProjectId arrive asynchronously from Home.razor,
        // after Viewport's first render - so this has to re-attempt
        // initialization whenever they change. InitializeTrimbleViewerAsync
        // itself is a no-op once _viewerInitialized is true, so this is
        // safe to call on every parameter update.
        await InitializeTrimbleViewerAsync();
    }

    private async Task InitializeTrimbleViewerAsync()
    {
        if (_viewerInitialized)
            return;

        // OnParametersSetAsync can re-fire on every re-render anywhere
        // up the tree (a dropdown toggle, a list selection, etc.), not
        // just when AccessToken/ProjectId actually change. Without this
        // guard, an overlapping call could start while the first one is
        // still awaiting init3DViewer, causing the iframe to be reset
        // mid-load - repeatedly - which looks like an endless spinner.
        if (_viewerInitializing)
            return;

        if (string.IsNullOrWhiteSpace(AccessToken))
        {
            Console.WriteLine("Trimble: waiting for access token.");
            return;
        }

        if (string.IsNullOrWhiteSpace(ProjectId))
        {
            Console.WriteLine("Trimble: waiting for project ID.");
            return;
        }

        if (_trimbleModule is null)
            return;

        _viewerInitializing = true;

        try
        {
            var initialized = await _trimbleModule.InvokeAsync<bool>(
                "initializeViewer",
                _iframeRef,
                AccessToken,
                ProjectId,
                "Bj9R4CgdWgs", // TODO: still hardcoded - resolve via the model-state event (see OnTrimbleEvent below) rather than a literal
                null);

            if (initialized)
            {
                _viewerInitialized = true;

                Console.WriteLine(
                    "Trimble 3D viewer initialized successfully.");
            }
            else
            {
                Console.WriteLine(
                    "Trimble 3D viewer failed to initialize.");
            }
        }
        catch (Exception ex)
        {
            Console.WriteLine(
                $"Trimble viewer initialization error: {ex}");
        }
        finally
        {
            _viewerInitializing = false;
        }
    }

    /// <summary>
    /// Highlights the given object (by GUID (MS)) in the embedded 3D
    /// viewer. Called from BIMViewport when a member is clicked in
    /// LeftAside.
    ///
    /// NOTE: "selectObjectByGuid" on the JS side is currently a
    /// placeholder that just logs - the real Trimble viewer selection
    /// call still needs to be confirmed/implemented there.
    /// </summary>
    public async Task SelectObjectAsync(Guid guid)
    {
        if (_trimbleModule is null)
        {
            Console.WriteLine("Trimble: viewer module not loaded yet, cannot select object.");
            return;
        }

        try
        {
            await _trimbleModule.InvokeVoidAsync(
                "selectObjectByGuid",
                guid.ToString());
        }
        catch (Exception ex)
        {
            Console.WriteLine($"Trimble: failed to select object {guid}: {ex.Message}");
        }
    }

    public async ValueTask DisposeAsync()
    {
        if (_trimbleModule is not null)
        {
            try
            {
                await _trimbleModule.InvokeVoidAsync(
                    "disposeViewer");
            }
            catch
            {
                // Viewer may already be disconnected.
            }

            await _trimbleModule.DisposeAsync();
        }
    }





}
