try {
    if (!getWorkspaceApi()) {
        await loadEmbeddedViewerIframe(iframeElement);
        console.log("[ParaMatic] step: connect");
        setWorkspaceApi(await window.TrimbleConnectWorkspace.connect(
            iframeElement, handleViewerEvent, 30000));
    }

    const workspaceAPI = getWorkspaceApi();

    console.log("[ParaMatic] step: setTokens");
    const tokenAccepted = await workspaceAPI.embed.setTokens({ accessToken });
    if (!tokenAccepted) { console.error("[ParaMatic] token rejected."); return false; }

    console.log("[ParaMatic] step: init3DViewer", { projectId, modelId });
    await workspaceAPI.embed.init3DViewer({ projectId, modelId });

    console.log("[ParaMatic] step: setUI");
    await workspaceAPI.ui.setUI({ name: "SidePanel", state: "hidden" });

    console.log("[ParaMatic] step: done");
    return true;
} catch (error) {
    console.error("[ParaMatic] Embedded viewer initialization failed.", error);
    return false;
}
