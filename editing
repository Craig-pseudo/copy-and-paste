@inject IJSRuntime JS


<section class="flex flex-1 min-h-0 h-full w-full gap-2">

    <!-- Left side -->
    <LeftAside Members="@_members" OnMemberSelected="HandleMemberSelected" />

    <!-- BIM -->
    <Viewport @ref="_viewportRef" AccessToken="@AccessToken" ProjectId="@ProjectId" />

    <!-- Right side -->
    <RightAside />

</section>

@code {

    [Parameter]
    public string? AccessToken { get; set; }

    [Parameter]
    public string? ProjectId { get; set; }

    private Viewport? _viewportRef;

    // TODO: replace with the real beam list once it's loaded from
    // beamData.json / the live model instead of hardcoded here.
    private List<LeftAside.MemberSummary> _members = new()
    {
        new() { Guid = Guid.Parse("4fec0fcb-4002-4f0e-b2fd-37073501040d"), Name = "Beam Loss" },
        new() { Guid = Guid.Parse("969a6149-13ad-49e3-8369-6f2bd4c4c557"), Name = "Web Section Loss" },
        new() { Guid = Guid.Parse("84877aa1-443a-496f-b5e2-fece48feb460"), Name = "Web Section Loss 2" }
    };

    private async Task HandleMemberSelected(Guid guid)
    {
        _selectedMember = _members.FirstOrDefault(m => m.Guid == guid);
        if (_viewportRef is not null)
        {
            await _viewportRef.SelectObjectAsync(guid);
        }
    }

}
